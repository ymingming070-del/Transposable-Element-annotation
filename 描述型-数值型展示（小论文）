# 数值型性状优与其他组对比展示(半小提琴图+箱线图+散点图) 
library(ggplot2)
library(ggdist)    
library(ggsignif)  

# ==========================================
# 2. 读取并【强制锁定】数据顺序
# ==========================================
file_path <- "C:/Users/JackYee/Desktop/xinshaohuayashuliang.csv"
data_raw <- read.csv(file_path)

# 锁定顺序：优在左，其他在右
data_raw$Group <- factor(data_raw$Group, levels = c("优Excellent", "其他Other"))

# ==========================================
# 3. 控制台输出：两组的统计学定量对比
# ==========================================
group_excel <- data_raw$Value[data_raw$Group == "优Excellent"]
group_other <- data_raw$Value[data_raw$Group == "其他Other"]

mean_excel <- mean(group_excel, na.rm = TRUE)
sd_excel   <- sd(group_excel, na.rm = TRUE)
mean_other <- mean(group_other, na.rm = TRUE)
sd_other   <- sd(group_other, na.rm = TRUE)

cat("\n==========================================\n")
cat("          📊 两组数据描述性统计结果          \n")
cat("==========================================\n")
cat(sprintf("【优Excellent】组: 均值 = %.4f, 标准差 = %.4f, 样本量 = %d\n", mean_excel, sd_excel, length(group_excel)))
cat(sprintf("【其他Other】  组: 均值 = %.4f, 标准差 = %.4f, 样本量 = %d\n", mean_other, sd_other, length(group_other)))
cat("------------------------------------------\n\n")

# ⬇️ 【修改点1】执行单尾、等方差 t 检验
t_test_result <- t.test(Value ~ Group, data = data_raw, alternative = "greater", var.equal = TRUE)

print("==========================================")
print("     ⚖️ 两组 t 检验 (单尾, 等方差) 结果     ")
print("==========================================")
print(t_test_result)
cat("\n")

# ==========================================
# 4. 定义云雨图函数 (修复小提琴图“被切断”的问题)
# ==========================================
create_raincloud_with_stats <- function(data, value_col, group_col) {
  
  max_val <- max(data[[value_col]], na.rm = TRUE)
  y_max   <- ceiling((max_val + 5) / 5) * 5  
  
  p <- ggplot(data, aes(x = .data[[group_col]], y = .data[[value_col]], fill = .data[[group_col]])) +
    
    # a. 散点图
    geom_jitter(
      aes(color = .data[[group_col]]),
      width = 0.05, height = 0, alpha = 0.6, size = 2.5
    ) +
    
    # b. 半小提琴图 
    ggdist::stat_halfeye(
      adjust = 0.5, width = 0.6, .width = 0,
      justification = 0,         
      point_colour = NA, alpha = 0.7,
      position = position_nudge(x = 0.15),
      trim = FALSE  # 【核心修改】：关闭裁剪，让曲线平滑延伸出尖端！
    ) +
    
    # c. 误差棒 
    stat_boxplot(
      geom = "errorbar",
      width = 0.04,
      position = position_nudge(x = 0.15)  
    ) +
    
    # d. 箱线图 
    geom_boxplot(
      width = 0.04,                          
      outlier.shape = NA,
      alpha = 1,
      fill = "white",
      position = position_nudge(x = 0.15)  
    ) +
    
    # e. 样式美化与坐标轴
    scale_y_continuous(
      limits = c(0, y_max),       
      breaks = seq(0, y_max, 5)   
    ) +
    
    scale_fill_manual(values = c("优Excellent" = "#2CB1AF", "其他Other" = "#E9847E")) +
    scale_color_manual(values = c("优Excellent" = "#2CB1AF", "其他Other" = "#E9847E")) +
    
    theme_classic() +
    theme(
      legend.position = "none",          
      axis.text = element_text(size = 12, face = "bold"),
      axis.title = element_text(size = 14, face = "bold")
    ) +
    labs(y = "Value", x = "Group")
  
  return(list(plot = p, y_position = y_max - 2))
}
# ==========================================
# 5. 执行绘图并自动叠加显著性检验
# ==========================================
plot_output <- create_raincloud_with_stats(data = data_raw, value_col = "Value", group_col = "Group")
p_base      <- plot_output$plot
y_pos       <- plot_output$y_position

# ⬇️ 【修改点2】添加星号 (告诉画图插件也要用单尾、等方差去算星号)
p_final <- p_base + 
  geom_signif(
    comparisons = list(c("优Excellent", "其他Other")), 
    map_signif_level = TRUE,  
    test = "t.test",
    test.args = list(alternative = "greater", var.equal = TRUE), # 传参给画图包
    y_position = y_pos,       
    textsize = 6
  )

print(p_final)
# 将您的图保存为高分辨率的 PDF 文件（矢量图，无限放大不模糊）
ggsave(
  filename = "C:/Users/JackYee/Desktop/xinshaohuaya.pdf", 
  plot = p_final,     
  width = 3.5,          
  height = 5.0,
  device = cairo_pdf   # 【关键修改】：调用 cairo_pdf 引擎，完美支持中文导出
)

