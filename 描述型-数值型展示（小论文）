#描述型性状优组与其他组对比展示
# ==========================================
# 1. 加载必要的包
# ==========================================
library(ggplot2)
library(scales)   

# ==========================================
# 2. 读取并锁定数据顺序
# ==========================================
file_path <- "C:/Users/JackYee/Desktop/huase.csv" 
data_raw <- read.csv(file_path)

data_raw$Group <- factor(data_raw$Group, levels = c("优Excellent", "其他Other"))
data_raw$Value <- factor(data_raw$Value, levels = c("E", "D", "C", "B", "A"))

# ==========================================
# 3. 后台计算：卡方检验 与 各色块占比
# ==========================================
count_table <- table(data_raw$Group, data_raw$Value)
chi_test    <- chisq.test(count_table)
p_val       <- chi_test$p.value

signif_marker <- if (p_val < 0.001) "***" else if (p_val < 0.01) "**" else if (p_val < 0.05) "*" else "ns"

stat_info_text <- paste0(
  "Chi-squared = ", round(chi_test$statistic, 3), "\n",
  "df = ", chi_test$parameter, "\n",
  "P = ", sprintf("%.4f", p_val)
)

df_counts <- as.data.frame(count_table)
colnames(df_counts) <- c("Group", "Value", "Freq")
df_counts$Percentage <- df_counts$Freq / ave(df_counts$Freq, df_counts$Group, FUN = sum)
df_counts$Label <- ifelse(df_counts$Freq > 0, paste0(round(df_counts$Percentage * 100, 1), "%"), "")

# ==========================================
# 4. 绘制图表 (应用您的高级马卡龙自定义配色)
# ==========================================
p_bar <- ggplot(df_counts, aes(x = Group, y = Percentage, fill = Value)) +
  
  geom_col(color = "black", width = 0.5) + 
  
  geom_text(
    aes(label = Label), 
    position = position_stack(vjust = 0.5), 
    size = 4, fontface = "bold", color = "black"
  ) +
  
  scale_y_continuous(
    labels = scales::percent, 
    limits = c(0, 1.25), 
    breaks = seq(0, 1, 0.2)
  ) +
  
  # 💡【核心修改】：使用您提供的 5 个专属十六进制颜色代码！
  scale_fill_manual(
    values = c(
      "E" = "#89CBAF", # 浅绿
      "D" = "#9FC8EA", # 浅蓝
      "C" = "#FBAB72", # 浅橙
      "B" = "#E87E7F", # 浅红/粉
      "A" = "#D0BEEA"  # 浅紫
    )
  ) +
  
  # 顶部手绘大括号、星号与统计学看板
  annotate("segment", x = 1, xend = 2, y = 1.03, yend = 1.03, linewidth = 0.6) +
  annotate("segment", x = 1, xend = 1, y = 1.03, yend = 1.01, linewidth = 0.6) +
  annotate("segment", x = 2, xend = 2, y = 1.03, yend = 1.01, linewidth = 0.6) +
  annotate("text", x = 1.5, y = 1.05, label = signif_marker, size = 6, fontface = "bold") +
  annotate("text", x = 1.5, y = 1.15, label = stat_info_text, size = 4, fontface = "italic", lineheight = 0.9) +
  
  # 样式美化
  theme_classic() +
  labs(
    x = "Group",
    y = "Percentage (%)",
    fill = "Value Level (E is Best)"
  ) +
  theme(
    axis.text = element_text(size = 12, face = "bold"),
    axis.title = element_text(size = 14, face = "bold"),
    legend.title = element_text(size = 12, face = "bold"),
    legend.text = element_text(size = 11)
  )

print(p_bar)

# ==========================================
# 5. 导出为高清矢量 PDF
# ==========================================
ggsave(
  filename = "C:/Users/JackYee/Desktop/HUAXIANG.pdf", 
  plot = p_bar,     
  width = 5,          
  height = 6,
  device = cairo_pdf   
)

